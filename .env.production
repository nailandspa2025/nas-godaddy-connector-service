PORT=6009
# Public URL of this service
PUBLIC_BASE_URL=https://api.nasshine.com/godaddy
# Required for /api/paylinks* (server-to-server, e.g. nas-order-api PaylinkSettings:ApiKey)
ADMIN_API_KEY=

# Payment page nằm ở nas-portal: app/portal tự ghép link = {portal}/pay/{id}
# Browser origins allowed to call /api/pay/* (comma separated)
CORS_ORIGINS=*

# nas-catalog-api: per-store Poynt config (BusinessId/StoreId/DeviceId)
CATALOG_API_URL=http://nas-catalog-api:6004

# Poynt PRODUCTION. OTE: https://services-ote.poynt.net / https://collect.commerce.ote-godaddy.com/sdk.js
POYNT_API_URL=https://services.poynt.net
POYNT_COLLECT_SDK_URL=https://collect.commerce.godaddy.com/sdk.js
POYNT_APPLICATION_ID=urn:aid:eed2c3ba-0f81-475b-8220-4d8472154c64
# Private key: path to PEM file, or inline (\n escaped)
POYNT_PRIVATE_KEY_PATH=./keys/private.pem
POYNT_PRIVATE_KEY=

# Test merchant "NAS VN" — cần ít nhất 1 terminal ACTIVATED thì Poynt Collect mới tạo được nonce
POYNT_BUSINESS_ID=a52bbace-3d8e-4578-856c-f7fe0d836c99
# Để trống: tự lấy store ACTIVE đầu tiên + device ACTIVATED đầu tiên
POYNT_STORE_ID=1d989418-88b1-4505-a5e5-26b559bdf1c5
POYNT_DEVICE_ID=urn:tid:4bb628ec-9a1d-350c-8f9c-fd1aa4755f48
DEFAULT_CURRENCY=USD

PAYLINK_DATA_FILE=./data/paylinks.json
# PostgreSQL (database + bảng tự tạo khi start)
DATABASE_URL=postgresql://postgres:canhlv1%403@postgres_db:5432/Nas-GoDaddy
