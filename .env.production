PORT=6009
# Public URL of this service
PUBLIC_BASE_URL=http://localhost:3100
# Required for /api/paylinks* (server-to-server, e.g. nas-order-api PaylinkSettings:ApiKey)
ADMIN_API_KEY=

# Payment page lives in nas-portal: link = {PAYMENT_PAGE_URL}/{id}
PAYMENT_PAGE_URL=http://portal.nasshine.com/pay
# Browser origins allowed to call /api/pay/* (comma separated)
CORS_ORIGINS=http://nas-catalog-api:6004

# nas-catalog-api: per-store Poynt config (BusinessId/StoreId/DeviceId)
CATALOG_API_URL=http://nas-catalog-api:6004

# Poynt (OTE). Production: https://services.poynt.net / https://collect.commerce.godaddy.com/sdk.js
POYNT_API_URL=https://services-ote.poynt.net
POYNT_COLLECT_SDK_URL=https://collect.commerce.ote-godaddy.com/sdk.js
POYNT_APPLICATION_ID=urn:aid:e0266d2f-a443-49e6-97f3-ee74d364d9f6
# Private key: path to PEM file, or inline (\n escaped)
POYNT_PRIVATE_KEY_PATH=./keys/private.pem
POYNT_PRIVATE_KEY=

# Test merchant "NAS VN" — cần ít nhất 1 terminal ACTIVATED thì Poynt Collect mới tạo được nonce
POYNT_BUSINESS_ID=e33ba889-31c1-4679-a627-97e81efe6f36
# Để trống: tự lấy store ACTIVE đầu tiên + device ACTIVATED đầu tiên
POYNT_STORE_ID=fdc16ac9-e43c-41e8-b50c-dfbede2144d1
POYNT_DEVICE_ID=urn:tid:a5e2b8fc-4bf8-3cd3-94f7-0376d894c37e
DEFAULT_CURRENCY=USD

PAYLINK_DATA_FILE=./data/paylinks.json
# PostgreSQL (database + bảng tự tạo khi start)
DATABASE_URL=postgresql://postgres:canhlv1@3@localhost:5432/Nas-GoDaddy
